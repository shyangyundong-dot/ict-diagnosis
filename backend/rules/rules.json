{
  "version": "v2.1.0",
  "rules": [
    {
      "id": "R01",
      "layer": 1,
      "name": "虚假项目",
      "trigger": {
        "logic": "MANUAL",
        "conditions": []
      },
      "risk_level": "high",
      "risk_description": "不存在实际业务需求，业务流程系人为虚构。此规则需人工核查——需核实项目是否有真实商业需求和实质交付环节。",
      "remediation": "立即终止项目推进。需核实：①是否存在真实业务需求；②客户是否为实际使用方；③业务流程是否有实质性交付环节。如核实后确认非虚假项目，需逐项提供证明材料。",
      "clause_id": "clause_R01",
      "optimization_direction": "此类项目不存在合规列收路径，应放弃。如确有真实需求，需彻底重构项目模式——去除关联关系并融入电信自有能力。",
      "applies_to": [
        "all"
      ],
      "high_risk_type": "forbidden",
      "audit_material_refs": [
        {
          "material_id": "MAT-PROC-R03",
          "purposes": [
            "证明真实业务需求存在"
          ]
        },
        {
          "material_id": "MAT-PROC-R01",
          "purposes": [
            "证明商机真实性",
            "证明商机录入合规"
          ]
        },
        {
          "material_id": "MAT-COND-PHOTO-001",
          "purposes": [
            "证明客户实体及业务场景真实"
          ]
        },
        {
          "material_id": "MAT-FIN-OWNERSHIP-001",
          "purposes": [
            "排除货权未实际转移、仅自制单据流转（货物流核查）",
            "排除关联方层层回流、资金空转（资金流核查）",
            "排除虚开/错开/后向异常抵扣（发票流核查）"
          ]
        }
      ]
    },
    {
      "id": "R02",
      "layer": 1,
      "name": "前后向关联关系+无增值",
      "trigger": {
        "logic": "AND",
        "conditions": [
          {
            "field": "related_party",
            "operator": "eq",
            "value": "yes"
          },
          {
            "field": "has_telecom_capability",
            "operator": "eq",
            "value": "no"
          }
        ]
      },
      "risk_level": "high",
      "risk_description": "前向客户与后向供应商存在关联关系（同一控制人/收付款账户相同），且电信未提供任何实质性增值服务。",
      "remediation": "立即终止。如需继续：①去除前后向关联关系或更换供应商；②融入电信自有产品或服务能力，体现实质性增值。",
      "clause_id": "clause_R02",
      "optimization_direction": "重新评估项目价值链，引入非关联供应商，同时融入电信自有云网、运维等能力，体现电信在交易中的独立价值。",
      "applies_to": [
        "all"
      ],
      "high_risk_type": "forbidden",
      "audit_material_refs": [
        {
          "material_id": "MAT-COND-REL-001",
          "purposes": [
            "核实前后向是否存在关联关系"
          ]
        },
        {
          "material_id": "MAT-COND-VALUE-001",
          "purposes": [
            "证明电信提供了实质性增值"
          ]
        },
        {
          "material_id": "MAT-PROC-R01",
          "purposes": [
            "证明商机合规"
          ]
        }
      ]
    },
    {
      "id": "R03",
      "layer": 1,
      "name": "三零项目",
      "trigger": {
        "logic": "AND",
        "conditions": [
          {
            "field": "gross_margin",
            "operator": "eq",
            "value": "lte_0"
          },
          {
            "field": "capability_ratio",
            "operator": "eq",
            "value": "all_external"
          },
          {
            "field": "contract_content_same",
            "operator": "eq",
            "value": "yes"
          }
        ]
      },
      "risk_level": "high",
      "risk_description": "同时满足：零利润（毛利率≤0%）+ 零自有能力投入 + 零增值（前后向合同内容完全一致），符合「三零项目」认定标准。",
      "remediation": "当前模式不可列收。必须至少解决一个「零」：①提升毛利率；②融入自有能力；③在合同中体现电信差异化服务内容。",
      "clause_id": "clause_R03",
      "optimization_direction": "三方向突破：①融入电信云网/安全等自有产品提升自研占比；②在合同中增加集成调试、项目管理、运维等电信侧价值项；③通过差额列收合规处理。",
      "applies_to": [
        "all"
      ],
      "high_risk_type": "no_revenue",
      "audit_material_refs": [
        {
          "material_id": "MAT-FIN-COST-001",
          "purposes": [
            "核实毛利率真实水平"
          ]
        },
        {
          "material_id": "MAT-PROC-R03",
          "purposes": [
            "证明电信自有能力融入"
          ]
        },
        {
          "material_id": "MAT-PROC-X001",
          "purposes": [
            "证明合同内容存在差异"
          ]
        }
      ]
    },
    {
      "id": "R05",
      "layer": 1,
      "name": "十个不准（任一条）",
      "trigger": {
        "logic": "MANUAL",
        "conditions": []
      },
      "risk_level": "high",
      "risk_description": "综合性规则——集团「十个不准」中任意一条被触发即为高风险。各子条款已分别体现在R01-R03、R09、R12、R13等规则中。本规则提醒用户对照附录一完整条款逐条自查。",
      "remediation": "对照「十个不准」完整条款逐条自查：①不准背离主业；②不准参与无商业目的贸易；③不准增加不必要交易环节；④不准融资性贸易；⑤不准无控制权空转走单；⑥不准循环贸易；⑦不准三流不齐备；⑧不准非标仓单交易；⑨不准代理行为全额列收；⑩不准缺乏内控。",
      "clause_id": "clause_R05",
      "optimization_direction": "确保项目具备商业实质、电信拥有控制权、不存在关联关系空转等问题。",
      "applies_to": [
        "all"
      ],
      "high_risk_type": "forbidden",
      "audit_material_refs": [
        {
          "material_id": "MAT-PROC-X002",
          "purposes": [
            "证明具备真实商业目的"
          ]
        },
        {
          "material_id": "MAT-FIN-CONTROL-001",
          "purposes": [
            "证明电信有实质控制"
          ]
        },
        {
          "material_id": "MAT-COND-REL-001",
          "purposes": [
            "排除关联交易嫌疑"
          ]
        }
      ]
    },
    {
      "id": "R06",
      "layer": 2,
      "name": "有自有能力，总集总包",
      "trigger": {
        "logic": "AND",
        "conditions": [
          {
            "field": "has_telecom_capability",
            "operator": "eq",
            "value": "yes"
          },
          {
            "field": "scheme_reviewed",
            "operator": "eq",
            "value": "yes"
          }
        ]
      },
      "risk_level": "low",
      "risk_description": "电信融入自有产品/能力，且作为总集成商承担总体规划、系统集成、售后运维责任，控制权充分，可全额列收。",
      "remediation": "当前模式合规。建议保持并强化「六到位」过程留痕，确保审计可追溯。",
      "clause_id": "clause_R06",
      "optimization_direction": "当前模式良好，建议持续提升自有能力占比，巩固总集总包地位。",
      "applies_to": [
        "system_integration",
        "software_development"
      ],
      "audit_material_refs": [
        {
          "material_id": "MAT-PROC-R03",
          "purposes": [
