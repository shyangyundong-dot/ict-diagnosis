          ]
        }
      ]
    },
    {
      "id": "R08",
      "layer": 2,
      "name": "控制权证据核查（附件1六维度）",
      "trigger": {
        "logic": "OR",
        "conditions": [
          {
            "field": "capability_ratio",
            "operator": "eq",
            "value": "all_external"
          },
          {
            "field": "capability_ratio",
            "operator": "eq",
            "value": "very_low"
          },
          {
            "field": "has_telecom_capability",
            "operator": "eq",
            "value": "partial"
          }
        ]
      },
      "risk_level": "medium",
      "risk_description": "自有能力占比较低或仅部分融入，触发附件1 六维度控制权核查（《企业会计准则第14号》主要责任人/代理人判断）。【核心情形（三选其一即可证明取得控制权）】（一）从第三方取得商品控制权（出入库记录、供应商交付产品技术文档）；（二）主导第三方提供服务（自主选择供应商、掌握方案设计/实施方案制定权、对供应商验收/过程强管控/考核培训）；（三）重大服务进行整合产出（平台设计权、重大定制化开发或修改、深度安装调测、复杂集成、关键数据迁移、二开等）。【其他迹象（佐证控制权）】（四）承担转让商品/服务的主要责任（以前向甲方视角获取统一功能产出、电信对质量/性能负责、提供培训/售后）；（五）承担商品的存货风险（合同前已购买或承诺购买特定产品、供应商产品在电信入库管理、电信承担存货毁损灭失风险）；（六）有决定价格的权利（电信自主决定交易商品价格、定价非固定比例、交易存在适当的毛利 ≥5%）。判定逻辑：六项全部「是」→低风险支持总额法；1-2项「否」→中风险（提级审批）；3项以上「否」→高风险（强烈建议差额）；核心情形全失（一/二/三 均「否」）或（四）主要责任「否」→直接高风险（主要责任人地位不成立）。",
      "remediation": "请逐项确认附件1 六维度控制权核查：\n（一）从第三方取得商品控制权？——能否提供出入库记录或供应商交付产品的技术文档？\n（二）主导第三方提供服务？——是否自主选择供应商、掌握方案/实施方案制定权、对供应商验收和过程做强管控？\n（三）重大服务进行整合产出？——是否承担平台设计、重大定制化开发/修改、深度安装调测、复杂集成、关键数据迁移、二开等？\n（四）承担转让商品/服务的主要责任？——是否以前向甲方视角获取统一功能产出、对质量/性能负责、提供培训/售后？\n（五）承担商品的存货风险？——合同前是否已购买或承诺购买特定产品、产品是否在电信入库管理、电信是否承担存货毁损灭失？\n（六）有决定价格的权利？——电信是否自主决定交易价格、定价非固定比例、交易存在适当毛利（≥5%）？",
      "clause_id": "clause_R08",
      "optimization_direction": "针对核查为「否」的维度逐一补强：核心情形（一/二/三）三选其一须确凿，其余三个迹象补充佐证。常见补强：增加电信主导的验收环节、建立运维责任机制、在合同中明确定价权与存货风险承担条款、增加自有平台/能力的深度集成。",
      "applies_to": [
        "system_integration",
        "software_development"
      ],
      "audit_material_refs": [
        {
          "material_id": "MAT-FIN-CONTROL-001",
          "purposes": [
            "记录附件1 六维度（三种核心情形 + 三个其他迹象）的逐项核查结果"
          ]
        },
        {
          "material_id": "MAT-FIN-RESP-001",
          "purposes": [
            "证明电信承担主要风险"
          ]
        },
        {
          "material_id": "MAT-FIN-PRICE-001",
          "purposes": [
            "证明电信拥有定价权"
          ]
        },
        {
          "material_id": "MAT-PROC-R18",
          "purposes": [
            "证明电信为第一服务界面"
          ]
        },
        {
          "material_id": "MAT-COND-VALUE-001",
          "purposes": [
            "证明实质性增值"
          ]
        },
        {
          "material_id": "MAT-PROC-R09",
          "purposes": [
            "证明电信有独立的实施规划能力，是控制权的核心佐证材料",
            "证明电信主持项目协调，体现实质控制权（C1）",
            "证明电信占据「全流程交付管理与质量责任者」总额法必选角色",
            "证明电信主导第三方提供服务（控制权核心情形之一）"
          ]
        },
        {
          "material_id": "MAT-EXC-X002",
          "purposes": [
            "证明电信承担了项目风险管控责任（C2、C4）"
          ]
        },
        {
          "material_id": "MAT-PROC-R07",
          "purposes": [
            "证明电信占据「软硬件采购决策者」总额法必选角色"
          ]
        }
      ]
    },
