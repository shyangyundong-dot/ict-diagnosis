# DeepSeek 大模型 API（必填）
DEEPSEEK_API_KEY=

# JWT 签名密钥（必填，生产前必须改）
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# 首次部署时自举 admin 账号（user 表为空时生效）
# 建账号后建议清空，避免后续被误读
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ChangeMeOnFirstLogin

# CORS 白名单（逗号分隔）。未配置时回退到开发白名单 localhost:5173；生产部署必须显式设置
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://ict.yourdomain.com

# 可选：数据库路径（相对于 backend/）
# DATABASE_PATH=../data/diagnosis.db

# 可选：未完成会话过期小时数
# CHAT_SESSION_STALE_HOURS=24
# CHAT_SESSION_CLEANUP_INTERVAL_SEC=21600
