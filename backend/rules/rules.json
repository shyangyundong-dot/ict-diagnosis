        },
        {
          "material_id": "MAT-PROC-X005",
          "purposes": [
            "变更发生时须留存，证明变更经过合规审批，防止审计认定合同造假"
          ]
        }
      ]
    },
    {
      "id": "R07",
      "layer": 2,
      "name": "无自有能力但有总控",
      "trigger": {
        "logic": "AND",
        "conditions": [
          {
            "field": "has_telecom_capability",
            "operator": "eq",
            "value": "no"
          },
          {
            "field": "scheme_reviewed",
            "operator": "eq",
            "value": "yes"
          },
          {
            "field": "contract_content_same",
            "operator": "neq",
            "value": "yes"
          }
        ]
      },
      "risk_level": "medium",
      "risk_description": "无自有产品融入，但电信承担总体规划设计、项目管理、客户界面责任，后向供应商仅为分包执行。需通过角色证据包与R08控制权核查确认后方可全额列收。",
      "remediation": "按统一材料编号补齐方案主导、项目管理和客户界面的角色证据包，并同步完成R08控制权核查。",
      "clause_id": "clause_R07",
      "optimization_direction": "尽快融入电信自有产品或能力，提升从代理人向主要责任人的角色转变。",
      "applies_to": [
        "system_integration",
        "software_development"
      ],
      "audit_material_refs": [
        {
          "material_id": "MAT-PROC-R03",
          "purposes": [
