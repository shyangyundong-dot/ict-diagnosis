    {
      "id": "R10",
      "layer": 2,
      "name": "异地项目有实施能力",
      "trigger": {
        "logic": "AND",
        "conditions": [
          {
            "field": "project_location",
            "operator": "eq",
            "value": "remote_with_capability"
          }
        ]
      },
